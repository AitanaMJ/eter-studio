# --- Entorno: development | production
ENVIRONMENT=development

# --- PostgreSQL (driver psycopg 3). Si la contraseña tiene caracteres especiales, codificarlos (ej: @ -> %40)
DATABASE_URL=postgresql+psycopg://postgres:CAMBIAR_PASSWORD@localhost:5433/eter_studio

# --- Seguridad
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
ACCESS_TOKEN_MINUTES=480
# true en producción (requiere HTTPS)
COOKIE_SECURE=false
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Usuario administrador (se crea con: python -m app.seed)
ADMIN_EMAIL=admin@eterstudio.com
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
ADMIN_NAME=Administrador

# --- Modo demostración
# true: habilita la cuenta demo y la restauración de datos. Usar SOLO en una instancia/base de demo.
DEMO_MODE=true
DEMO_EMAIL=demo@eterstudio.com
DEMO_PASSWORD=CAMBIAR_PASSWORD_DEMO
# Restaura automáticamente los datos demo cada N minutos (0 = desactivado)
DEMO_RESET_INTERVAL_MINUTES=0

# --- Archivos
# MEDIA_DIR=./uploads
MAX_UPLOAD_MB=8
DEMO_MAX_UPLOAD_MB=3
LOW_STOCK_THRESHOLD=5
# Si se define, FastAPI sirve también el build del frontend (un solo servidor)
# FRONTEND_DIST=../frontend/dist
